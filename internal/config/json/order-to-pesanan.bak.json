{
  "entity": "order-to-pesanan",
  "sources": [
    { "alias": "o", "from": "order" }
  ],
  "target_table": "pesanan",
  "key": {
    "strategy": "natural",
    "source": ["d.order_id"]
  },
  "columns": {
    "id": { "from": "$key" },
    "id_ojol": {
      "foreign": {
        "relation_name": "driver-to-ojol",
        "source_key_cols": ["d.driver_id"],
        "target_key_cols": ["id"]
      }
    },
    "status": { "from": "o.status" },
    "nominal": { "from": "o.amount" },
    "catatan": { "from": "o.note" },
    "titik_jemput": { "from": "o.depart_location" },
    "titik_tujuan": { "from": "o.purpose_location" },
    "created_at": { "from": "d.created_at" },
    "updated_at": { "expr": "now()" }
  },
  "routing": {
    "on_snapshot": { "mode": "insert" },
    "on_create": { "mode": "insert" },
    "on_update": { "mode": "update", "matchKey": ["id"] }
  }
}
