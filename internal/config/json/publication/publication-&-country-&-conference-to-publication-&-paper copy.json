{
  "entity": "publication-&-country-&-conference-to-publication-&-paper",
  "sources": [
    { "alias": "p", "from": "publication" },
    {
      "alias": "c",
      "from": "country",
      "join": {
        "fact_column": "pub_cntry",
        "dim_column": "cntry_id"
      }
    },
    {
      "alias": "f",
      "from": "conference",
      "join": {
        "fact_column": "pub_id",
        "dim_column": "conf_id"
      }
    }
  ],
  "target_table": "publication",
  "key": {
    "strategy": "natural",
    "source": "p.pub_id"
  },
  "columns": {
    "code": {
      "from": "$key",
      "cast": "integer"
    },
    "title": { "from": "f.conf_name" },
    "place": { "from": "p.pub_loc" },
    "country": { "from": "c.cntry_name_en" },
    "year": { "from": "p.pub_year" },
    "publisher_name": { "from": "p.pub_edit" },
    "publicationtype_name": { "default": "CONFERENCE" }
  },
  "split_table": [
    {
      "table_name": "paper",
      "columns": {
        "doi": {
          "from": "$key",
          "cast": "integer"
        },
        "title": { "from": "p.pub_title" },
        "startpage": { "from": "f.conf_start_page" },
        "endpage": { "from": "f.conf_end_page" },
        "publication_code": { "from": "$key", "cast": "integer" }
      }
    }
  ],
  "routing": {
    "on_snapshot": { "mode": "insert" },
    "on_create": { "mode": "insert" },
    "on_update": { "mode": "update", "matchKey": ["code"] }
  }
}
