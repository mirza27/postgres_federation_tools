{
  "entity": "publication_writer-to-authorship",
  "sources": [{ "alias": "pir", "from": "publication_writer" }],
  "target_table": "authorship",
  "key": {
    "strategy": "shared_key",
    "source": "pir.pub_id",
    "resolver": {
      "type": "mapping_table",
      "table": "_keymap_publication_writer-to-authorship"
    }
  },
  "columns": {
    "code": {
      "from": "$key",
      "expr": "uuid()"
    },
    "paper_doi": { "from": "pir.pub_id", "cast": "string" },
    "author_code": { "from": "pir.rese_id" },
    "orderofauthor": { "from": "pir.pirrit_ord" }
  },
  "routing": {
    "on_snapshot": { "mode": "insert" },
    "on_create": { "mode": "insert" },
    "on_update": { "mode": "update", "matchKey": ["code"] }
  }
}
