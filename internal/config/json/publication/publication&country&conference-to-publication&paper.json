{
  "entity": "publication-&-country-&-conference-to-paper-&-publication",
  "sources": [
    { "alias": "p", "from": "publication" },
    {
      "alias": "c",
      "from": "country",
      "join": {
        "match_with": "p",
        "fact_column": "pub_cntry",
        "dim_column": "cntry_id"
      }
    },
    {
      "alias": "f",
      "from": "conference",
      "join": {
        "match_with": "p",
        "fact_column": "pub_id",
        "dim_column": "conf_id"
      }
    }
  ],
  "target_table": "paper",
  "key": {
    "strategy": "natural",
    "source": ["p.pub_id"]
  },
  "columns": {
    "doi": {
      "from": "$key"
    },
    "title": { "from": "p.pub_title" },
    "startpage": { "from": "f.conf_start_page" },
    "endpage": { "from": "f.conf_end_page" },
    "publication_code": { "from": "$key" }
  },
  "split_table": [
    {
      "table_name": "publication",
      "columns": {
        "code": { "from": "$key" },
        "title": { "from": "c.conf_name" },
        "place": { "from": "p.pub_name" },
        "country": { "from": "c.cntr_name_en" },
        "publisher_name": { "from": "p.pub_edit" },
        "publicationtype_name": { "default": "PAPER" }
      }
    }
  ],
  "routing": {
    "on_snapshot": { "mode": "insert" },
    "on_create": { "mode": "insert" },
    "on_update": { "mode": "update", "matchKey": ["code"] }
  }
}
