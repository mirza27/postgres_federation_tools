{
  "entity": "publication-&-country-to-publication",
  "kind": "table",
  "sources": [
    { "alias": "p", "from": "publication" },
    {
      "alias": "c",
      "from": "country",
      "join": {
        "match_with": "p",
        "fact_column": "pub_cntry",
        "dim_column": "cntry_id"
      }
    }
  ],
  "target_table": "publication",
  "key": {
    "strategy": "surrogate",
    "source": ["p.pub_id"],
    "resolver": {
      "type": "mapping_table",
      "table": "_keymap_publication-&-country-to-publication"
    }
  },
  "columns": {
    "code": {
      "from": "$key",
      "expr": "random_number(1, 1000000000)"
    },
    "title": { "from": "p.pub_title" },
    "place": { "from": "p.pub_loc" },
    "country": { "from": "c.cntr_name_en" },
    "year": { "from": "p.pub_year" },
    "publisher_name": { "from": "p.pub_edit" }
  },
  "routing": {
    "on_snapshot": { "mode": "insert" },
    "on_create": { "mode": "insert" },
    "on_update": { "mode": "update", "matchKey": ["code"] }
  }
}
