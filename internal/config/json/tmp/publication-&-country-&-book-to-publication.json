{
  "entity": "publication-&-country-&-book-to-publication",
  "sources": [
    { "alias": "p", "from": "publication" },
    {
      "alias": "c",
      "from": "country",
      "join": {
        "fact_column": "pub_cntry",
        "dim_column": "cntry_id"
      }
    },
    {
      "alias": "b",
      "from": "book",
      "join": {
        "fact_column": "pub_id",
        "dim_column": "book_id"
      }
    }
  ],
  "target_table": "publication",
  "key": {
    "strategy": "shared_key",
    "source": "p.pub_id",
    "resolver": {
      "type": "mapping_table",
      "table": "_keymap_publication-&-country-&-book-to-publication"
    }
  },
  "columns": {
    "code": {
      "from": "$key"
    },
    "title": { "from": "p.pub_title" },
    "place": { "from": "p.pub_loc" },
    "country": { "from": "c.cntry_name_en" },
    "year": { "from": "p.pub_year" },
    "publicationtype_name": { "default": "BOOK" },
    "publisher_name": { "from": "p.pub_edit" }
  },
  "routing": {
    "on_snapshot": { "mode": "insert" },
    "on_create": { "mode": "insert" },
    "on_update": { "mode": "update", "matchKey": ["code"] }
  }
}
