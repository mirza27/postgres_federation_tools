{
  "entity": "publication-&-country-&-journal-to-publication-&-paper",
  "sources": [
    { "alias": "p", "from": "publication" },
    {
      "alias": "c",
      "from": "country",
      "join": {
        "fact_column": "pub_cntry",
        "dim_column": "cntry_id"
      }
    },
    {
      "alias": "j",
      "from": "journal",
      "join": {
        "fact_column": "pub_id",
        "dim_column": "jrnl_id"
      }
    }
  ],
  "target_table": "publication",
  "key": {
    "strategy": "shared_key",
    "source": "p.pub_id",
    "resolver": {
      "type": "mapping_table",
      "table": "_keymap_publication-&-country-&-journal-to-publication-&-paper"
    }
  },
  "columns": {
    "code": {
      "from": "$key"
    },
    "title": { "from": "j.jrnl_journ_title" },
    "place": { "from": "p.pub_loc" },
    "country": { "from": "c.cntry_name_en" },
    "year": { "from": "p.pub_year" },
    "publisher_name": { "from": "p.pub_edit" },
    "publicationtype_name": { "default": "JOURNAL" }
  },
  "split_table": [
    {
      "table_name": "paper",
      "columns": {
        "doi": {
          "from": "p.pub_id",
          "cast": "string"
        },
        "title": { "from": "j.jrnl_journ_title" },
        "startpage": { "from": "j.jrnl_start_page" },
        "endpage": { "from": "j.jrnl_end_page" },
        "publication_code": { "from": "$key" }
      }
    }
  ],
  "routing": {
    "on_snapshot": { "mode": "insert" },
    "on_create": { "mode": "insert" },
    "on_update": { "mode": "update", "matchKey": ["code"] }
  }
}
