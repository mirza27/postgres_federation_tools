{
  "entity": "driver-to-ojol",
  "sources": [
    { "alias": "d", "from": "drivers" },
    {
      "alias": "u",
      "from": "users",
      "join": {
        "fact_column": "user_id",
        "dim_column": "id"
      }
    }
  ],
  "target_table": "ojol",
  "key": {
    "strategy": "shared_key",
    "source": "d.driver_id",
    "resolver" : {
      "type": "mapping_table",
      "table": "_keymap_user",
      "relation_name": "driver-to-ojol"
    }
  },
  "columns": {
    "id": { "from": "$key" },
    "nama": { "from": "d.name" },
    "telepon" : { "from": "d.phone" },
    "password" : {"from": "u.password"},
    "email": { "from": "u.email" },
    "kendaraan" : { "from": "d.vehicle_info" },
    "status": { "from": "d.status", "cast": "text" },
    "created_at": { "from": "d.created_at" },
    "updated_at": { "expr": "now()" }
  },
  "routing": {
    "on_snapshot": { "mode": "insert" },
    "on_create": { "mode": "insert" },
    "on_update": { "mode": "update", "matchKey": ["id"] }
  }
}
