{
  "entity": "driver-to-ojol",
  "kind": "table",
  "sources": [
    { "alias": "d", "from": "src.drivers", "topic": "db_events_drivers" },
    { "alias": "u", "from": "src.users", "topic": "db_events_users", 
      "join": { "on":"d.user_id = u.id", "type": "left" }
  }
  ],
  "target_table": "ojol",
  "key": {
    "strategy": "shared_key",
    "source": ["d.driver_id"],
    "resolver" : {
      "type": "mapping_table",
      "table": "_keymap_user",
      "relation_name": "driver-to-ojol",
      "source_key_col": "src_driver_id",
      "target_key_col": "tgt_ojol_id"
    }
  },
  "columns": {
    "id": { "from": "$key" },
    "nama": { "from": "d.name" },
    "telepon" : { "from": "d.phone" },
    "password" : {"from": "u.password"},
    "email": { "from": "u.email" },
    "kendaraan" : { "from": "d.vehicle_info" },
    "status": { "from": "d.status", "cast": "text" },
    "created_at": { "from": "d.created_at" },
    "updated_at": { "expr": "now()" }
  },
  "routing": {
    "on_create": { "writeMode": "upsert", "conflictKey": ["id"] },
    "on_update": { "writeMode": "upsert", "conflictKey": ["id"] },
    "on_delete": { "writeMode": "delete", "matchKey": ["id"] },
    "on_snapshot": { "writeMode": "upsert", "conflictKey": ["id"] }
  }
}
