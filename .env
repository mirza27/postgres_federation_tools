TARGET_DSN=postgres://${NEW_USERNAME}:${NEW_PASSWORD}@localhost:${NEW_OUT_PORT}/${NEW_DATABASE}?sslmode=disable
MAPPING_PATH=./internal/config/json/publication
BATCH_MAX_ROWS=1000
BATCH_MAX_INTERVAL=1000
JOIN_WAIT_TTL=120

