{
  "version": "1.0",
  "defaults": {
    "target_db1": {
      "users": {
        "created_at": "NOW()",
        "status": "active"
      }
    }
  },
  "transformations": {
    "date_to_string": "TO_CHAR({value}, 'YYYY-MM-DD')",
    "string_to_int": "CAST({value} AS INTEGER)"
  },
  "mappings": [
    {
      "source_table": "users",
      "source_condition": "deleted = false",
      "target_tables": [
        {
          "database": "target_db1",
          "table": "tbl_users",
          "operation_handling": {
            "insert": true,
            "update": true,
            "delete": "soft_delete"
          },
          "column_mappings": [
            {
              "source_column": "id",
              "target_column": "user_id",
              "transformation": "string_to_int"
            },
            {
              "source_column": "fullname",
              "target_column": "username"
            },
            {
              "source_column": "email",
              "target_column": "email_address"
            },
            {
              "source_column": "null",
              "target_column": "status",
              "default_value": "active"
            },
            {
              "source_expression": "CONCAT(first_name, ' ', last_name)",
              "target_column": "display_name"
            }
          ],
          "key_mapping": {
            "primary_key": {
              "source": "id",
              "target": "user_id"
            }
          }
        }
      ]
    },
    {
      "source_table": "drivers",
      "target_tables": [
        {
          "database": "old_ev_db",
          "table": "pengemudi",
          "operation_handling" : {
            "insert" : true,
            "update" : true,
            "delete" : "soft_delete"
          },
          "column_mappings": [
            {
              "source_column": "driver_id",
              "target_column": "id_pengemudi"
            },
            {
              "source_column": "user_id",
              "target_column": "customer_id"
            }
          ],
           "key_mapping": {
            "primary_key": {
              "source": "driver_id",
              "target": "id_pengemudi"
            }
          }
        }
      ]
    }
  ],
  "conflict_resolution": {
    "strategy": "source_wins",
    "timestamp_column": "last_updated"
  }
}