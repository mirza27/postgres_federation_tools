{
  "name": "publication-connector",
  "config": {
    "topic.prefix": "publication",
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "provide.transaction.metadata": "true",
    "database.hostname": "old_publication_db",
    "database.port": "5432",
    "database.user": "old_user",
    "database.password": "jdfmhuvdas",
    "database.dbname": "old_publication_db",

    "plugin.name": "pgoutput",
    "slot.name": "debezium_slot_v2",
    "publication.name": "dbz_publication",
    "table.include.list": "public.(.*)",
    "tombstones.on.delete": "true",
    "transforms": "route",

    "snapshot.mode": "initial",

    "slot.drop.on.stop": "true",

    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "([^.]+)\\.([^.]+)\\.([^.]+)",
    "transforms.route.replacement": "db_events_$3"
  }
}
